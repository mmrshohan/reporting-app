# Copy to .env for local development. Never commit real values.

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://report:report@localhost:5432/report

# Authentication
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Transcription provider (provider and credentials chosen during implementation)
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=

# Logging
LOG_LEVEL=INFO
