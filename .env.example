# Copy to .env for local development. Never commit real values.

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# PostgreSQL
DATABASE_URL=postgresql://report:report@localhost:5432/report

# Authentication
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# AI/transcription providers (providers and credentials chosen through later ADRs)
AI_PROVIDER=
AI_API_KEY=
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=

# Logging
LOG_LEVEL=info
